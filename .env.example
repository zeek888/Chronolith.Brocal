# Brocal · variables para docker-compose.yml (módulo de ChronoLith en desarrollo). Copia a .env y ajusta.
# Los valores por omisión coinciden con ChronoLith/infra y ChronoLith/shell en una máquina de desarrollo.

BROCAL_VERSION=latest
TZ=America/Mexico_City

# Base de datos propia de Brocal (PostgreSQL)
BROCAL_DB_USER=brocal
BROCAL_DB_PASSWORD=brocal
BROCAL_DB_PORT=5436

# URL pública del módulo (remoteEntry.json y /api) y puerto en el host
BROCAL_PUBLIC_URL=http://localhost:4303
WEB_PORT=4303
BROCAL_ROUTE_PATH=brocal

# Plataforma ChronoLith
CHRONOLITH_SHELL_URL=http://localhost:8081
SHELL_API_INTERNAL_URL=http://shell-api:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=chronolith
KEYCLOAK_REQUIRE_HTTPS=false
# Secreto del cliente chronolith-brocal-api (lo crea scripts/ensure-keycloak-clients)
KC_BROCAL_API_CLIENT_SECRET=chronolith-brocal-api-dev-secret
# true: al invitar a alguien sin cuenta, Brocal la crea en Keycloak (ensure-keycloak-clients -ProvisionUsers)
BROCAL_PROVISION_USERS=false

# Datos de ejemplo: empresa demo cuyo administrador es la cuenta de ChronoLith con este correo
BROCAL_SEED_DEMO=true
BROCAL_DEMO_ADMIN_EMAIL=admin@chronolith.local
BROCAL_REQUIRE_VERIFIED_EMAIL=true

# Firma de los enlaces temporales a archivos (32 o más caracteres)
BROCAL_FILES_SIGNING_KEY=brocal-dev-signing-key-change-me-0123456789abcdef

# Correo de la plataforma (opcional; sin servidor los avisos quedan como "simulados" en la bitácora de envíos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@brocal.local
