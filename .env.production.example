# Brocal · producción del modo módulo (docker-compose.yml + docker-compose.prod.yml detrás de chronolith-gateway).
# Copia a .env en el servidor; las variables sin valor por omisión en docker-compose.prod.yml son obligatorias.

BROCAL_VERSION=1.0.0
TZ=America/Mexico_City

BROCAL_DB_USER=brocal
BROCAL_DB_PASSWORD=cambia-esta-contrasena

# El gateway publica el módulo bajo /modules/brocal/ (remoteEntry.json y /api)
BROCAL_PUBLIC_URL=https://chronolith.com.mx/modules/brocal
CHRONOLITH_SHELL_URL=https://chronolith.com.mx
SHELL_API_INTERNAL_URL=http://shell-api:8080
KEYCLOAK_PUBLIC_URL=https://chronolith.com.mx/auth
# Keycloak escucha bajo /auth también dentro de chronolith-net.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=chronolith
KC_BROCAL_API_CLIENT_SECRET=genera-un-secreto-largo

# 32 o más caracteres aleatorios (p. ej. openssl rand -base64 48). Cambiarlo invalida los enlaces a archivos ya emitidos.
BROCAL_FILES_SIGNING_KEY=genera-una-llave-larga-y-aleatoria

BROCAL_SEED_DEMO=false

SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@chronolith.com.mx
