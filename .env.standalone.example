# Brocal · modo independiente (docker-compose.standalone.yml): Keycloak propio, sin ChronoLith.
# Copia a standalone.env (no a .env, que es del modo módulo; git ignora ambos) y ajusta; en producción cambia todas
# las contraseñas y secretos.
#   docker compose -f docker-compose.standalone.yml --env-file standalone.env up -d --build

BROCAL_VERSION=latest
TZ=America/Mexico_City
ASPNETCORE_ENVIRONMENT=Production

# URLs públicas (las del navegador)
BROCAL_PUBLIC_URL=http://localhost:4303
WEB_PORT=4303
KEYCLOAK_PUBLIC_URL=http://localhost:8181
KEYCLOAK_PORT=8181

# Keycloak (consola de administración en KEYCLOAK_PUBLIC_URL/admin)
KEYCLOAK_VERSION=26.4
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
# Secreto del cliente brocal-api del realm "brocal" (alta de usuarios al invitar)
KC_BROCAL_API_CLIENT_SECRET=brocal-api-dev-secret

# Usuarios iniciales del realm (solo en la primera importación): admin y los usuarios de la empresa demo
BROCAL_ADMIN_PASSWORD=Brocal2026!
BROCAL_DEMO_PASSWORD=Demo2026!

# Base de datos de Brocal
BROCAL_DB_USER=brocal
BROCAL_DB_PASSWORD=brocal
BROCAL_DB_PORT=5436
BROCAL_SEED_DEMO=true

# Firma de los enlaces temporales a archivos (32 o más caracteres)
BROCAL_FILES_SIGNING_KEY=brocal-dev-signing-key-change-me-0123456789abcdef

# Licencia de ChronoLith. Vacía: la de desarrollo incluida en docker-compose.standalone.yml, que solo se acepta con
# KEYCLOAK_PUBLIC_URL en localhost. Con otra URL pública, pon aquí el token emitido para esta instalación.
# LICENSE_KEY=

# Opcional: enlace "Abrir ChronoLith" y tema de ChronoLith tomado de su API
CHRONOLITH_SHELL_URL=
SHELL_API_URL=
# Opcional, con SHELL_API_URL: cuenta de servicio del realm "chronolith" (rol chronolith-module-registrar) para
# replicar los catálogos maestros del Shell (pozos, instalaciones, campos, compañías) y enviar los cambios de
# locaciones y clientes enlazados. Vacío = Brocal usa solo sus catálogos. Ver docs/integracion-chronolith.md.
SHELL_KEYCLOAK_URL=
SHELL_REALM=chronolith
SHELL_CLIENT_ID=
SHELL_CLIENT_SECRET=
# Cada cuántos minutos se consulta el feed de cambios del Shell (1 a 5 según el contrato de módulos)
CATALOG_FEED_MINUTES=2

# Correo (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@brocal.local
