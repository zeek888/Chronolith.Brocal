<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="chronolith" value="nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="chronolith">
      <package pattern="ChronoLith.Licensing" />
      <package pattern="ChronoLith.Licensing.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
