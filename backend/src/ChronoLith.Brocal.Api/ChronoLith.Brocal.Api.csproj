<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ChronoLith.Brocal.Api</RootNamespace>
    <UserSecretsId>chronolith-brocal-api</UserSecretsId>
    <!-- The ASP.NET route-handler analyzer crashes on the generic catalog endpoints (MapCatalog<TEntity, TData, TDto>). -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChronoLith.Brocal.Application\ChronoLith.Brocal.Application.csproj" />
    <ProjectReference Include="..\ChronoLith.Brocal.Infrastructure\ChronoLith.Brocal.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
