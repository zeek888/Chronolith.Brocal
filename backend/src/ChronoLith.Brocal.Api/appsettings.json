{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BrocalDb": "Host=localhost;Port=5436;Database=chronolith_brocal;Username=brocal;Password=brocal;GSS Encryption Mode=Disable"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoTenant": false,
    "DemoAdminEmail": "admin@chronolith.local"
  },
  "Tenancy": {
    "Mode": "ChronoLith",
    "RequireVerifiedEmail": true
  },
  "Keycloak": {
    "AuthServerUrl": "http://localhost:8080",
    "InternalAuthServerUrl": "",
    "Realm": "chronolith",
    "Audiences": [ "chronolith-api" ],
    "RequireHttpsMetadata": true,
    "PlatformAdminRoles": [ "chronolith-admin", "brocal-platform-admin" ],
    "ClientId": "chronolith-brocal-api",
    "ClientSecret": ""
  },
  "Shell": {
    "ApiUrl": "http://localhost:5080",
    "PermissionsCacheSeconds": 120,
    "RequireAccessPermission": true
  },
  "ModuleRegistration": {
    "Enabled": true,
    "RemoteEntryUrl": "http://localhost:4303/remoteEntry.json",
    "ApiUrl": "http://localhost:4303/api",
    "RoutePath": "brocal",
    "SortOrder": 20
  },
  "Identity": {
    "ProvisionUsers": false
  },
  "Files": {
    "RootPath": "data/files",
    "SigningKey": "",
    "DefaultUrlLifetimeMinutes": 60
  },
  "DataProtection": {
    "KeysPath": "data/keys"
  },
  "Pdf": {
    "FontsPath": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "User": "",
    "Password": "",
    "FromAddress": "no-reply@brocal.local",
    "FromName": "Brocal"
  },
  "WhatsApp": {
    "ApiBaseUrl": "https://graph.facebook.com",
    "ApiVersion": "v21.0"
  },
  "Jobs": {
    "Enabled": true,
    "ScanIntervalMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
