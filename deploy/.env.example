# Brocal · producción independiente en el servidor de ChronoLith (deploy/docker-compose.yml). Ver docs/produccion.md.
# Copia a deploy/.env en el servidor (git lo ignora) y cambia todas las contraseñas y secretos:
#   openssl rand -hex 32
# Evita $ ; " \ y espacios en contraseñas y secretos (Compose y los scripts los interpretan).

BROCAL_VERSION=1.0.0
TZ=America/Mexico_City

# Sitio: el Nginx del servidor publica BROCAL_PUBLIC_URL con TLS y reenvía a 127.0.0.1:BROCAL_WEB_PORT.
BROCAL_PUBLIC_URL=https://brocal.chronolith.com.mx
BROCAL_WEB_PORT=8094

# Keycloak de ChronoLith: URL pública (emisor de los tokens y página de inicio de sesión) e interna (chronolith-net).
KEYCLOAK_PUBLIC_URL=https://chronolith.com.mx/auth
KEYCLOAK_INTERNAL_URL=http://chronolith-keycloak:8080/auth
KEYCLOAK_REALM=brocal
# Secreto del cliente brocal-api; deploy/keycloak/ensure-realm.sh lo registra en el realm.
KC_BROCAL_API_CLIENT_SECRET=genera-un-secreto-largo

# Primer administrador de la plataforma Brocal: ensure-realm.sh crea su cuenta con una contraseña temporal.
BROCAL_ADMIN_EMAIL=

# Base de datos de Brocal (solo accesible desde la red interna).
BROCAL_DB_USER=brocal
BROCAL_DB_PASSWORD=genera-una-contrasena

# Firma de los enlaces temporales a archivos: 32 o más caracteres aleatorios. Cambiarla invalida los enlaces emitidos.
BROCAL_FILES_SIGNING_KEY=genera-una-llave-larga-y-aleatoria

# Empresa de demostración "Servicios Petroleros del Sureste" (solo para presentaciones).
BROCAL_SEED_DEMO=false

# Correo de la plataforma: avisos de Brocal y "¿Olvidaste tu contraseña?" del realm (ensure-realm.sh lo copia a
# Keycloak). Puerto 587 = STARTTLS, 465 = SSL. Muchos proveedores exigen que SMTP_FROM sea la cuenta de SMTP_USER o
# un alias suyo. Cada empresa puede usar su propio SMTP desde Configuración → Notificaciones.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Brocal

# Opcional: enlace "Abrir ChronoLith" en la barra de Brocal (p. ej. https://chronolith.com.mx).
CHRONOLITH_SHELL_URL=
